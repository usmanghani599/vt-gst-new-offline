# Copy to build.env (same folder as package.json) and fill in. build.env is never committed.
# Your live online VTGST address (must start with https://, no trailing slash)
VTGST_SERVER_URL=https://your-vtgst-domain.com

# Optional: Google Drive backup (Google Cloud -> OAuth client of type "Desktop app")
VTGST_GOOGLE_CLIENT_ID=
VTGST_GOOGLE_CLIENT_SECRET=

# The license public key goes in license-public.pem (paste the whole
# -----BEGIN PUBLIC KEY----- ... -----END PUBLIC KEY----- block printed by
# `npx tsx scripts/generate-desktop-keys.ts` in the online project).
