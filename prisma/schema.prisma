  billingGstin       String?
  shippingAddress    String?           
  shippingStateId    String?
  shippingState      State?             @relation("ShippingState", fields: [shippingStateId], references: [id], onDelete: SetNull)
  placeOfSupplyStateId String?
  placeOfSupplyState State?             @relation("PosState", fields: [placeOfSupplyStateId], references: [id], onDelete: SetNull)
  reverseCharge      Boolean            @default(false)
  taxMode            TaxMode            @default(TAX_EXCLUSIVE)
  currencyCode       String             @default("INR")
  exchangeRate       Decimal            @default(1.0000)
  subTotal           Decimal            @default(0.00)
  taxTotal           Decimal            @default(0.00)
  discountTotal      Decimal            @default(0.00)
  freightCharges     Decimal            @default(0.00)
  packingCharges     Decimal            @default(0.00)
  otherCharges       Decimal            @default(0.00)
  roundOff           Decimal            @default(0.00)
  grandTotal         Decimal            @default(0.00)
  paidAmount         Decimal            @default(0.00)
  balanceAmount      Decimal            @default(0.00)
  status             DocumentStatus     @default(POSTED)
  paymentStatus      PaymentStatus      @default(UNPAID)
  salesmanId         String?
  salesman           Salesman?          @relation(fields: [salesmanId], references: [id], onDelete: SetNull)
  notes              String?           
  termsConditions    String?           
  createdByUserId    String?
  createdByUser      User?              @relation("DocCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  cancelledAt        DateTime?
  cancelledReason    String?           
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  items              DocumentItem[]
  taxes              DocumentTax[]
  transport          DocumentTransport?
  exportInfo         DocumentExport?
  ledgerEntries      LedgerEntry[]
  stockMovements     StockMovement[]
