model User {
  id            String      @id @default(uuid())
  name          String
  email         String      @unique
  mobile        String?
  passwordHash  String
  isSuperAdmin  Boolean     @default(false)
  status        UserStatus  @default(ACTIVE)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  ownedAccounts Account[]   @relation("AccountOwner")
  companyUsers  CompanyUser[]
  createdDocs   Document[]  @relation("DocCreatedBy")
  createdPayments Payment[] @relation("PaymentCreatedBy")
  salesmen      Salesman[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Account {
  id             String             @id @default(uuid())
  name           String
  ownerUserId    String
  ownerUser      User               @relation("AccountOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  trialStartedAt DateTime           @default(now())
  trialEndsAt    DateTime
  status         SubscriptionStatus @default(TRIAL)
  customFeatures String?           
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  subscriptions  AccountSubscription[]
  companies      Company[]

  @@index([ownerUserId])
  @@map("accounts")
}

model Plan {
  id            String             @id @default(uuid())
  code          String             @unique
  name          String
  description   String?           
  price         Decimal            @default(0.00)
  renewalPrice  Decimal            @default(0.00)
  currency      String             @default("INR")
  validityDays  Int                @default(365)
  companyLimit  Int                @default(1)
  userLimit     Int                @default(5)
  trialEligible Boolean            @default(true)
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  features      PlanFeature[]
