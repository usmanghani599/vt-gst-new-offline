  document             Document @relation("SourceDoc", fields: [documentId], references: [id], onDelete: Cascade)
  referencedDocumentId String
  referencedDocument   Document @relation("TargetDoc", fields: [referencedDocumentId], references: [id], onDelete: Restrict)
  relationType         String   @default("REFERENCE")

  @@index([documentId])
  @@index([referencedDocumentId])
  @@map("document_references")
}

// ----------------------------------------------------
// ACCOUNTING & STOCK LEDGERS
// ----------------------------------------------------

model LedgerEntry {
  id              String        @id @default(uuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialYearId String
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  partyId         String?
  party           Party?        @relation(fields: [partyId], references: [id], onDelete: SetNull)
  documentId      String?
  document        Document?     @relation(fields: [documentId], references: [id], onDelete: SetNull)
  paymentId       String?
  payment         Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  entryDate       DateTime
  accountHead     String        @default("GENERAL")
  debit           Decimal       @default(0.00)
  credit          Decimal       @default(0.00)
  narration       String?      
  createdAt       DateTime      @default(now())

  @@index([companyId, entryDate])
  @@index([companyId, partyId, entryDate])
  @@map("ledger_entries")
}

model Payment {
  id              String        @id @default(uuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialYearId String
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  paymentType     PaymentType   @default(IN_RECEIPT)
  paymentNumber   String
  paymentDate     DateTime
  partyId         String
  party           Party         @relation(fields: [partyId], references: [id], onDelete: Restrict)
  amount          Decimal      
  paymentMode     PaymentMode   @default(CASH)
  bankAccountId   String?
  bankAccount     BankAccount?  @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  referenceNumber String?
  chequeNumber    String?
  notes           String?      
  attachmentUrl   String?      
  createdByUserId String?
  createdByUser   User?         @relation("PaymentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())

  allocations     PaymentAllocation[]
  ledgerEntries   LedgerEntry[]

  @@unique([companyId, financialYearId, paymentNumber])
  @@index([companyId, paymentDate])
  @@index([partyId])
  @@map("payments")
}

model PaymentAllocation {
  id              String   @id @default(uuid())
  paymentId       String
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  documentId      String
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  allocatedAmount Decimal 

  @@index([paymentId])
  @@index([documentId])
  @@map("payment_allocations")
}

model StockMovement {
  id              String            @id @default(uuid())
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialYearId String
  financialYear   FinancialYear     @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  itemId          String
  item            Item              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  documentId      String?
  document        Document?         @relation(fields: [documentId], references: [id], onDelete: SetNull)
  movementType    StockMovementType
  quantity        Decimal          
  unitRate        Decimal           @default(0.00)
  totalValue      Decimal           @default(0.00)
  movementDate    DateTime
  notes           String?          
  createdAt       DateTime          @default(now())

  @@index([companyId, itemId, movementDate])
  @@map("stock_movements")
}

model DocumentDelivery {
  id           String          @id @default(uuid())
  documentId   String
  document     Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  channel      DeliveryChannel @default(EMAIL)
  recipient    String
  status       DeliveryStatus  @default(SENT)
  errorMessage String?        
  sentAt       DateTime        @default(now())

  @@index([documentId])
  @@map("document_deliveries")
}

// ----------------------------------------------------
// CLIENT PORTAL & CLIENT ORDERS
// ----------------------------------------------------

model ClientUser {
  id           String        @id @default(uuid())
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partyId      String        @unique
  party        Party         @relation(fields: [partyId], references: [id], onDelete: Cascade)
  name         String
  email        String?
  mobile       String
  passwordHash String
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  orders       ClientOrder[]

  @@unique([companyId, mobile])
  @@index([companyId])
  @@map("client_users")
}

model ClientOrder {
  id              String                  @id @default(uuid())
  companyId       String
  company         Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientUserId    String
  clientUser      ClientUser              @relation(fields: [clientUserId], references: [id], onDelete: Cascade)
  partyId         String
  party           Party                   @relation(fields: [partyId], references: [id], onDelete: Restrict)
  orderNumber     String
  orderType       OrderType               @default(ORGANIZED)
  status          OrderStatus             @default(PLACED)
  notes           String?                
  subTotal        Decimal                 @default(0.00)
  taxTotal        Decimal                 @default(0.00)
  grandTotal      Decimal                 @default(0.00)
  documentId      String?
  document        Document?               @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  items           ClientOrderItem[]
  attachments     ClientOrderAttachment[]

  @@unique([companyId, orderNumber])
  @@index([companyId, status])
  @@index([partyId])
  @@map("client_orders")
}

model ClientOrderItem {
  id          String      @id @default(uuid())
  orderId     String
  order       ClientOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId      String?
  item        Item?       @relation(fields: [itemId], references: [id], onDelete: SetNull)
  itemName    String
  quantity    Decimal    
  unitName    String?
  unitRate    Decimal    
  taxRate     Decimal     @default(0.0000)
  taxAmount     Decimal     @default(0.00)
  totalAmount   Decimal    
  notes         String?    
  attachmentUrl String?    

  @@index([orderId])
  @@map("client_order_items")
}

model ClientOrderAttachment {
  id          String         @id @default(uuid())
  orderId     String
  order       ClientOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fileType    AttachmentType @default(IMAGE)
  fileName    String
  fileUrl     String        
  r2Key       String
  fileSize    Int?
  durationSec Int?
  createdAt   DateTime       @default(now())

  @@index([orderId])
  @@map("client_order_attachments")
}

