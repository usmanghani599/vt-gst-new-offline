generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELLED
}

enum CompanyRole {
  OWNER
  ADMIN
  MANAGER
  ACCOUNTANT
  SALESMAN
  POS_OPERATOR
  READ_ONLY
}

enum TaxMode {
  TAX_EXCLUSIVE
  TAX_INCLUSIVE
}

enum GstRegType {
  REGULAR
  COMPOSITION
  UNREGISTERED
  CONSUMER
  OVERSEAS
  SEZ
  DEEMED_EXPORT
}

enum PartyType {
  CUSTOMER
  SUPPLIER
  BOTH
}

enum BalanceType {
  DEBIT
  CREDIT
}

enum DocumentType {
  SALE
  PURCHASE
  POS
  ESTIMATE
  BILL_OF_SUPPLY
  CREDIT_NOTE
  DEBIT_NOTE
  EXPORT_INVOICE
  JOB_WORK
  SALES_RETURN
  PURCHASE_RETURN
}

enum DocumentStatus {
  DRAFT
  POSTED
  CANCELLED
  VOID
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum PaymentType {
  IN_RECEIPT
  OUT_PAYMENT
}

enum PaymentMode {
  CASH
  BANK_TRANSFER
  UPI
  CARD
  CHEQUE
  CREDIT
  OTHER
}

enum StockMovementType {
  PURCHASE_IN
  SALE_OUT
  PURCHASE_RETURN_OUT
  SALE_RETURN_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  OPENING_STOCK
}

enum PointTransactionType {
  CREDIT
  DEBIT
  ADJUSTMENT
  EXPIRY
}

enum ExportType {
  WITH_PAYMENT_OF_TAX
  WITHOUT_PAYMENT_OF_TAX_UNDER_LUT
}

enum DeliveryChannel {
  EMAIL
  WHATSAPP
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum OrderType {
  ORGANIZED
  UNORGANIZED
}

enum OrderStatus {
  PLACED
  PENDING
  IN_PROCESS
  COMPLETED
  CANCELLED
}

enum AttachmentType {
  IMAGE
  AUDIO_RECORDING
  DOCUMENT
}

// ----------------------------------------------------
// SAAS TENANCY & AUTH
// ----------------------------------------------------

model User {
  id            String      @id @default(uuid())
  name          String
  email         String      @unique
  mobile        String?
  passwordHash  String
  isSuperAdmin  Boolean     @default(false)
  status        UserStatus  @default(ACTIVE)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  ownedAccounts Account[]   @relation("AccountOwner")
  companyUsers  CompanyUser[]
  createdDocs   Document[]  @relation("DocCreatedBy")
  createdPayments Payment[] @relation("PaymentCreatedBy")
  salesmen      Salesman[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Account {
  id             String             @id @default(uuid())
  name           String
  ownerUserId    String
  ownerUser      User               @relation("AccountOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  trialStartedAt DateTime           @default(now())
  trialEndsAt    DateTime
  status         SubscriptionStatus @default(TRIAL)
  customFeatures String?            @db.Text
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  subscriptions  AccountSubscription[]
  companies      Company[]

  @@index([ownerUserId])
  @@map("accounts")
}

model Plan {
  id            String             @id @default(uuid())
  code          String             @unique
  name          String
  description   String?            @db.Text
  price         Decimal            @default(0.00) @db.Decimal(18, 2)
  renewalPrice  Decimal            @default(0.00) @db.Decimal(18, 2)
  currency      String             @default("INR")
  validityDays  Int                @default(365)
  companyLimit  Int                @default(1)
  userLimit     Int                @default(5)
  trialEligible Boolean            @default(true)
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  features      PlanFeature[]
  subscriptions AccountSubscription[]

  @@map("plans")
}

model Feature {
  id          String        @id @default(uuid())
  code        String        @unique
  name        String
  category    String        @default("CORE")
  description String?       @db.Text
  createdAt   DateTime      @default(now())

  planFeatures PlanFeature[]

  @@map("features")
}

model PlanFeature {
  id        String   @id @default(uuid())
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureId String
  feature   Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)
  enabled   Boolean  @default(true)

  @@unique([planId, featureId])
  @@map("plan_features")
}

model AccountSubscription {
  id               String             @id @default(uuid())
  accountId        String
  account          Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  planId           String
  plan             Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  status           SubscriptionStatus @default(ACTIVE)
  startDate        DateTime
  endDate          DateTime
  amountPaid       Decimal            @default(0.00) @db.Decimal(18, 2)
  currency         String             @default("INR")
  gateway          String?
  paymentReference String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([accountId])
  @@map("account_subscriptions")
}

model Company {
  id               String      @id @default(uuid())
  accountId        String
  account          Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  countryId        String
  country          Country     @relation(fields: [countryId], references: [id], onDelete: Restrict)
  name             String
  legalName        String?
  logoUrl          String?     @db.Text
  description      String?     @db.Text
  localDescription String?     @db.Text
  address          String?     @db.Text
  city             String?
  pincode          String?
  stateId          String?
  state            State?      @relation(fields: [stateId], references: [id], onDelete: SetNull)
  phone            String?
  mobile           String?
  email            String?
  website          String?
  gstin            String?
  pan              String?
  taxId            String?
  fssaiNo          String?
  drugLicenseNo    String?
  defaultTaxMode   TaxMode     @default(TAX_EXCLUSIVE)
  posEnableTax     Boolean     @default(true)
  currencyCode     String      @default("INR")
  currencySymbol   String      @default("₹")
  timezone         String      @default("Asia/Kolkata")
  dateFormat       String      @default("DD/MM/YYYY")
  numberFormat     String      @default("en-IN")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  companyUsers     CompanyUser[]
  financialYears   FinancialYear[]
  parties          Party[]
  partyGroups      PartyGroup[]
  items            Item[]
  units            Unit[]
  itemCategories   ItemCategory[]
  bankAccounts     BankAccount[]
  salesmen         Salesman[]
  documents        Document[]
  documentSeries   DocumentSeries[]
  ledgerEntries    LedgerEntry[]
  payments         Payment[]
  stockMovements   StockMovement[]
  auditLogs        AuditLog[]
  clientUsers      ClientUser[]
  clientOrders     ClientOrder[]

  @@index([accountId])
  @@index([gstin])
  @@map("companies")
}

model CompanyUser {
  id        String      @id @default(uuid())
  companyId String
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      CompanyRole @default(MANAGER)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())

  @@unique([companyId, userId])
  @@index([userId])
  @@map("company_users")
}

model AuditLog {
  id         String   @id @default(uuid())
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  details    String?  @db.LongText
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([companyId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ----------------------------------------------------
// COUNTRY & GENERIC TAX ENGINE
// ----------------------------------------------------

model Country {
  id             String      @id @default(uuid())
  code           String      @unique
  name           String
  currencyCode   String      @default("INR")
  currencySymbol String      @default("₹")
  phoneCode      String      @default("91")
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())

  states         State[]
  taxSystems     TaxSystem[]
  companies      Company[]

  @@map("countries")
}

model State {
  id           String    @id @default(uuid())
  countryId    String
  country      Country   @relation(fields: [countryId], references: [id], onDelete: Cascade)
  code         String
  name         String
  stateCodeGst String?
  isUt         Boolean   @default(false)

  companies    Company[]
  parties      Party[]
  billingDocs  Document[] @relation("BillingState")
  shippingDocs Document[] @relation("ShippingState")
  posDocs      Document[] @relation("PosState")

  @@unique([countryId, code])
  @@index([stateCodeGst])
  @@map("states")
}

model TaxSystem {
  id          String     @id @default(uuid())
  countryId   String
  country     Country    @relation(fields: [countryId], references: [id], onDelete: Cascade)
  code        String     @unique
  name        String
  description String?    @db.Text
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())

  taxTypes    TaxType[]
  taxRates    TaxRate[]

  @@map("tax_systems")
}

model TaxType {
  id          String             @id @default(uuid())
  taxSystemId String
  taxSystem   TaxSystem          @relation(fields: [taxSystemId], references: [id], onDelete: Cascade)
  code        String
  name        String
  isActive    Boolean            @default(true)

  components  TaxRateComponent[]

  @@unique([taxSystemId, code])
  @@map("tax_types")
}

model TaxRate {
  id            String             @id @default(uuid())
  taxSystemId   String
  taxSystem     TaxSystem          @relation(fields: [taxSystemId], references: [id], onDelete: Cascade)
  name          String
  rate          Decimal            @db.Decimal(8, 4)
  isActive      Boolean            @default(true)
  effectiveFrom DateTime           @default(now())
  effectiveTo   DateTime?

  components    TaxRateComponent[]
  items         Item[]

  @@index([taxSystemId])
  @@map("tax_rates")
}

model TaxRateComponent {
  id             String   @id @default(uuid())
  taxRateId      String
  taxRate        TaxRate  @relation(fields: [taxRateId], references: [id], onDelete: Cascade)
  taxTypeId      String
  taxType        TaxType  @relation(fields: [taxTypeId], references: [id], onDelete: Restrict)
  ratePercentage Decimal  @db.Decimal(8, 4)

  @@unique([taxRateId, taxTypeId])
  @@map("tax_rate_components")
}

// ----------------------------------------------------
// FINANCIAL YEAR
// ----------------------------------------------------

model FinancialYear {
  id              String      @id @default(uuid())
  companyId       String
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  startDate       DateTime
  endDate         DateTime
  isClosed        Boolean     @default(false)
  closedAt        DateTime?
  closedByUserId  String?
  createdAt       DateTime    @default(now())

  closings        FinancialYearClosing[]
  documents       Document[]
  documentSeries  DocumentSeries[]
  ledgerEntries   LedgerEntry[]
  payments        Payment[]
  stockMovements  StockMovement[]

  @@unique([companyId, name])
  @@index([companyId, isClosed])
  @@map("financial_years")
}

model FinancialYearClosing {
  id              String        @id @default(uuid())
  financialYearId String
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  snapshotData    String        @db.LongText
  createdAt       DateTime      @default(now())

  @@index([financialYearId])
  @@map("financial_year_closings")
}

// ----------------------------------------------------
// MASTERS (PARTIES, ITEMS, UNITS, BANK, SALESMEN)
// ----------------------------------------------------

model PartyGroup {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())

  parties     Party[]

  @@unique([companyId, name])
  @@map("party_groups")
}

model Party {
  id                 String       @id @default(uuid())
  companyId          String
  company            Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partyGroupId       String?
  partyGroup         PartyGroup?  @relation(fields: [partyGroupId], references: [id], onDelete: SetNull)
  partyType          PartyType    @default(CUSTOMER)
  name               String
  legalName          String?
  phone              String?
  mobile             String?
  email              String?
  gstin              String?
  pan                String?
  taxId              String?
  gstRegType         GstRegType   @default(UNREGISTERED)
  stateId            String?
  state              State?       @relation(fields: [stateId], references: [id], onDelete: SetNull)
  city               String?
  pincode            String?
  billingAddress     String?      @db.Text
  shippingAddress    String?      @db.Text
  creditLimit        Decimal      @default(0.00) @db.Decimal(18, 2)
  openingBalance     Decimal      @default(0.00) @db.Decimal(18, 2)
  openingBalanceType BalanceType  @default(DEBIT)
  isWalkIn           Boolean      @default(false)
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  documents          Document[]
  ledgerEntries      LedgerEntry[]
  payments           Payment[]
  loyaltyAccount     LoyaltyAccount?
  clientUser         ClientUser?
  clientOrders       ClientOrder[]

  @@index([companyId, partyType])
  @@index([companyId, gstin])
  @@map("parties")
}

model Unit {
  id        String   @id @default(uuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code      String
  name      String
  uqcCode   String?
  isSystem  Boolean  @default(false)
  isActive  Boolean  @default(true)

  items     Item[]

  @@unique([companyId, code])
  @@map("units")
}

model ItemCategory {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())

  items       Item[]

  @@unique([companyId, name])
  @@map("item_categories")
}

model Item {
  id                String         @id @default(uuid())
  companyId         String
  company           Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categoryId        String?
  category          ItemCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name              String
  sku               String?
  barcode           String?
  description       String?        @db.Text
  hsnSac            String?
  unitId            String
  unit              Unit           @relation(fields: [unitId], references: [id], onDelete: Restrict)
  purchasePrice     Decimal        @default(0.00) @db.Decimal(18, 2)
  salesPrice        Decimal        @default(0.00) @db.Decimal(18, 2)
  mrp               Decimal        @default(0.00) @db.Decimal(18, 2)
  taxRateId         String?
  taxRate           TaxRate?       @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  cessRate          Decimal        @default(0.0000) @db.Decimal(8, 4)
  discountRate      Decimal        @default(0.0000) @db.Decimal(8, 4)
  minStockLevel     Decimal        @default(0.0000) @db.Decimal(18, 4)
  reorderLevel      Decimal        @default(0.0000) @db.Decimal(18, 4)
  openingStock      Decimal        @default(0.0000) @db.Decimal(18, 4)
  openingStockValue Decimal        @default(0.00) @db.Decimal(18, 2)
  isService         Boolean        @default(false)
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  documentItems     DocumentItem[]
  stockMovements    StockMovement[]
  clientOrderItems  ClientOrderItem[]

  @@index([companyId, sku])
  @@index([companyId, barcode])
  @@index([companyId, hsnSac])
  @@map("items")
}

model BankAccount {
  id            String    @id @default(uuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankName      String
  accountNumber String
  ifsc          String?
  swift         String?
  branch        String?
  upiId         String?
  isDefault     Boolean   @default(false)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  payments      Payment[]

  @@index([companyId])
  @@map("bank_accounts")
}

model Salesman {
  id              String                     @id @default(uuid())
  companyId       String
  company         Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  name            String
  employeeCode    String?
  mobile          String?
  email           String?
  address         String?                    @db.Text
  commissionRate  Decimal                    @default(0.0000) @db.Decimal(8, 4)
  pointsPerAmount Decimal                    @default(0.0000) @db.Decimal(8, 4)
  isActive        Boolean                    @default(true)
  createdAt       DateTime                   @default(now())

  documents       Document[]
  transactions    SalesmanPointTransaction[]

  @@unique([companyId, employeeCode])
  @@index([companyId])
  @@map("salesmen")
}

model SalesmanPointTransaction {
  id          String               @id @default(uuid())
  salesmanId  String
  salesman    Salesman             @relation(fields: [salesmanId], references: [id], onDelete: Cascade)
  documentId  String?
  document    Document?            @relation(fields: [documentId], references: [id], onDelete: SetNull)
  type        PointTransactionType @default(CREDIT)
  points      Decimal              @db.Decimal(18, 2)
  amount      Decimal              @default(0.00) @db.Decimal(18, 2)
  notes       String?              @db.Text
  createdAt   DateTime             @default(now())

  @@index([salesmanId])
  @@map("salesman_points_transactions")
}

model LoyaltyAccount {
  id            String               @id @default(uuid())
  partyId       String               @unique
  party         Party                @relation(fields: [partyId], references: [id], onDelete: Cascade)
  currentPoints Decimal              @default(0.00) @db.Decimal(18, 2)
  totalEarned   Decimal              @default(0.00) @db.Decimal(18, 2)
  totalRedeemed Decimal              @default(0.00) @db.Decimal(18, 2)
  updatedAt     DateTime             @updatedAt

  transactions  LoyaltyTransaction[]

  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id               String               @id @default(uuid())
  loyaltyAccountId String
  loyaltyAccount   LoyaltyAccount       @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
  documentId       String?
  document         Document?            @relation(fields: [documentId], references: [id], onDelete: SetNull)
  type             PointTransactionType @default(CREDIT)
  points           Decimal              @db.Decimal(18, 2)
  redemptionAmount Decimal              @default(0.00) @db.Decimal(18, 2)
  notes            String?              @db.Text
  createdAt        DateTime             @default(now())

  @@index([loyaltyAccountId])
  @@map("loyalty_transactions")
}

// ----------------------------------------------------
// UNIFIED DOCUMENT ENGINE
// ----------------------------------------------------

model DocumentSeries {
  id              String        @id @default(uuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialYearId String
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  documentType    DocumentType
  prefix          String
  nextNumber      Int           @default(1)
  isDefault       Boolean       @default(true)

  @@unique([companyId, financialYearId, documentType, prefix])
  @@map("document_series")
}

model Document {
  id                 String             @id @default(uuid())
  companyId          String
  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialYearId    String
  financialYear      FinancialYear      @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  documentType       DocumentType
  documentNumber     String
  documentDate       DateTime
  dueDate            DateTime?
  partyId            String?
  party              Party?             @relation(fields: [partyId], references: [id], onDelete: Restrict)
  billingPartyName   String?
  billingAddress     String?            @db.Text
  billingStateId     String?
  billingState       State?             @relation("BillingState", fields: [billingStateId], references: [id], onDelete: SetNull)
  billingGstin       String?
  shippingAddress    String?            @db.Text
  shippingStateId    String?
  shippingState      State?             @relation("ShippingState", fields: [shippingStateId], references: [id], onDelete: SetNull)
  placeOfSupplyStateId String?
  placeOfSupplyState State?             @relation("PosState", fields: [placeOfSupplyStateId], references: [id], onDelete: SetNull)
  reverseCharge      Boolean            @default(false)
  taxMode            TaxMode            @default(TAX_EXCLUSIVE)
  currencyCode       String             @default("INR")
  exchangeRate       Decimal            @default(1.0000) @db.Decimal(18, 4)
  subTotal           Decimal            @default(0.00) @db.Decimal(18, 2)
  taxTotal           Decimal            @default(0.00) @db.Decimal(18, 2)
  discountTotal      Decimal            @default(0.00) @db.Decimal(18, 2)
  freightCharges     Decimal            @default(0.00) @db.Decimal(18, 2)
  packingCharges     Decimal            @default(0.00) @db.Decimal(18, 2)
  otherCharges       Decimal            @default(0.00) @db.Decimal(18, 2)
  roundOff           Decimal            @default(0.00) @db.Decimal(18, 2)
  grandTotal         Decimal            @default(0.00) @db.Decimal(18, 2)
  paidAmount         Decimal            @default(0.00) @db.Decimal(18, 2)
  balanceAmount      Decimal            @default(0.00) @db.Decimal(18, 2)
  status             DocumentStatus     @default(POSTED)
  paymentStatus      PaymentStatus      @default(UNPAID)
  salesmanId         String?
  salesman           Salesman?          @relation(fields: [salesmanId], references: [id], onDelete: SetNull)
  notes              String?            @db.Text
  termsConditions    String?            @db.Text
  createdByUserId    String?
  createdByUser      User?              @relation("DocCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  cancelledAt        DateTime?
  cancelledReason    String?            @db.Text
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  items              DocumentItem[]
  taxes              DocumentTax[]
  transport          DocumentTransport?
  exportInfo         DocumentExport?
  ledgerEntries      LedgerEntry[]
  stockMovements     StockMovement[]
  paymentAllocations PaymentAllocation[]
  salesmanPoints     SalesmanPointTransaction[]
  loyaltyTransactions LoyaltyTransaction[]
  deliveries         DocumentDelivery[]
  sourceRefs         DocumentReference[] @relation("SourceDoc")
  targetRefs         DocumentReference[] @relation("TargetDoc")
  clientOrders       ClientOrder[]

  @@unique([companyId, financialYearId, documentType, documentNumber])
  @@index([companyId, documentType, documentDate])
  @@index([partyId])
  @@map("documents")
}

model DocumentItem {
  id             String   @id @default(uuid())
  documentId     String
  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  itemId         String?
  item           Item?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  itemName       String
  hsnSac         String?
  quantity       Decimal  @db.Decimal(18, 4)
  unitName       String?
  unitRate       Decimal  @db.Decimal(18, 2)
  grossAmount    Decimal  @db.Decimal(18, 2)
  discountRate   Decimal  @default(0.0000) @db.Decimal(8, 4)
  discountAmount Decimal  @default(0.00) @db.Decimal(18, 2)
  taxableAmount  Decimal  @db.Decimal(18, 2)
  taxRateId      String?
  taxPercentage  Decimal  @default(0.0000) @db.Decimal(8, 4)
  taxAmount      Decimal  @default(0.00) @db.Decimal(18, 2)
  cessRate       Decimal  @default(0.0000) @db.Decimal(8, 4)
  cessAmount     Decimal  @default(0.00) @db.Decimal(18, 2)
  totalAmount    Decimal  @db.Decimal(18, 2)

  @@index([documentId])
  @@map("document_items")
}

model DocumentTax {
  id                 String   @id @default(uuid())
  documentId         String
  document           Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  taxTypeCode        String
  taxRatePercentage  Decimal  @db.Decimal(8, 4)
  taxableAmount      Decimal  @db.Decimal(18, 2)
  taxAmount          Decimal  @db.Decimal(18, 2)

  @@index([documentId])
  @@map("document_taxes")
}

model DocumentTransport {
  id             String    @id @default(uuid())
  documentId     String    @unique
  document       Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  transporterName String?
  transporterId  String?
  vehicleNumber  String?
  lrNumber       String?
  lrDate         DateTime?
  distanceKm     Int?
  transportMode  String?
  ewayBillNumber String?
  ewayBillDate   DateTime?

  @@map("document_transport")
}

model DocumentExport {
  id                  String     @id @default(uuid())
  documentId          String     @unique
  document            Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  exportType          ExportType @default(WITHOUT_PAYMENT_OF_TAX_UNDER_LUT)
  lutNumber           String?
  portCode            String?
  shippingBillNumber  String?
  shippingBillDate    DateTime?
  foreignCurrencyCode String?    @default("USD")
  exchangeRate        Decimal    @default(1.0000) @db.Decimal(18, 4)
  foreignAmount       Decimal    @default(0.00) @db.Decimal(18, 2)

  @@map("document_exports")
}

model DocumentReference {
  id                   String   @id @default(uuid())
  documentId           String
  document             Document @relation("SourceDoc", fields: [documentId], references: [id], onDelete: Cascade)
  referencedDocumentId String
  referencedDocument   Document @relation("TargetDoc", fields: [referencedDocumentId], references: [id], onDelete: Restrict)
  relationType         String   @default("REFERENCE")

  @@index([documentId])
  @@index([referencedDocumentId])
  @@map("document_references")
}

// ----------------------------------------------------
// ACCOUNTING & STOCK LEDGERS
// ----------------------------------------------------

model LedgerEntry {
  id              String        @id @default(uuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialYearId String
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  partyId         String?
  party           Party?        @relation(fields: [partyId], references: [id], onDelete: SetNull)
  documentId      String?
  document        Document?     @relation(fields: [documentId], references: [id], onDelete: SetNull)
  paymentId       String?
  payment         Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  entryDate       DateTime
  accountHead     String        @default("GENERAL")
  debit           Decimal       @default(0.00) @db.Decimal(18, 2)
  credit          Decimal       @default(0.00) @db.Decimal(18, 2)
  narration       String?       @db.Text
  createdAt       DateTime      @default(now())

  @@index([companyId, entryDate])
  @@index([companyId, partyId, entryDate])
  @@map("ledger_entries")
}

model Payment {
  id              String        @id @default(uuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialYearId String
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  paymentType     PaymentType   @default(IN_RECEIPT)
  paymentNumber   String
  paymentDate     DateTime
  partyId         String
  party           Party         @relation(fields: [partyId], references: [id], onDelete: Restrict)
  amount          Decimal       @db.Decimal(18, 2)
  paymentMode     PaymentMode   @default(CASH)
  bankAccountId   String?
  bankAccount     BankAccount?  @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  referenceNumber String?
  chequeNumber    String?
  notes           String?       @db.Text
  attachmentUrl   String?       @db.Text
  createdByUserId String?
  createdByUser   User?         @relation("PaymentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())

  allocations     PaymentAllocation[]
  ledgerEntries   LedgerEntry[]

  @@unique([companyId, financialYearId, paymentNumber])
  @@index([companyId, paymentDate])
  @@index([partyId])
  @@map("payments")
}

model PaymentAllocation {
  id              String   @id @default(uuid())
  paymentId       String
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  documentId      String
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  allocatedAmount Decimal  @db.Decimal(18, 2)

  @@index([paymentId])
  @@index([documentId])
  @@map("payment_allocations")
}

model StockMovement {
  id              String            @id @default(uuid())
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialYearId String
  financialYear   FinancialYear     @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  itemId          String
  item            Item              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  documentId      String?
  document        Document?         @relation(fields: [documentId], references: [id], onDelete: SetNull)
  movementType    StockMovementType
  quantity        Decimal           @db.Decimal(18, 4)
  unitRate        Decimal           @default(0.00) @db.Decimal(18, 2)
  totalValue      Decimal           @default(0.00) @db.Decimal(18, 2)
  movementDate    DateTime
  notes           String?           @db.Text
  createdAt       DateTime          @default(now())

  @@index([companyId, itemId, movementDate])
  @@map("stock_movements")
}

model DocumentDelivery {
  id           String          @id @default(uuid())
  documentId   String
  document     Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  channel      DeliveryChannel @default(EMAIL)
  recipient    String
  status       DeliveryStatus  @default(SENT)
  errorMessage String?         @db.Text
  sentAt       DateTime        @default(now())

  @@index([documentId])
  @@map("document_deliveries")
}

// ----------------------------------------------------
// CLIENT PORTAL & CLIENT ORDERS
// ----------------------------------------------------

model ClientUser {
  id           String        @id @default(uuid())
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partyId      String        @unique
  party        Party         @relation(fields: [partyId], references: [id], onDelete: Cascade)
  name         String
  email        String?
  mobile       String
  passwordHash String
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  orders       ClientOrder[]

  @@unique([companyId, mobile])
  @@index([companyId])
  @@map("client_users")
}

model ClientOrder {
  id              String                  @id @default(uuid())
  companyId       String
  company         Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientUserId    String
  clientUser      ClientUser              @relation(fields: [clientUserId], references: [id], onDelete: Cascade)
  partyId         String
  party           Party                   @relation(fields: [partyId], references: [id], onDelete: Restrict)
  orderNumber     String
  orderType       OrderType               @default(ORGANIZED)
  status          OrderStatus             @default(PLACED)
  notes           String?                 @db.Text
  subTotal        Decimal                 @default(0.00) @db.Decimal(18, 2)
  taxTotal        Decimal                 @default(0.00) @db.Decimal(18, 2)
  grandTotal      Decimal                 @default(0.00) @db.Decimal(18, 2)
  documentId      String?
  document        Document?               @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  items           ClientOrderItem[]
  attachments     ClientOrderAttachment[]

  @@unique([companyId, orderNumber])
  @@index([companyId, status])
  @@index([partyId])
  @@map("client_orders")
}

model ClientOrderItem {
  id          String      @id @default(uuid())
  orderId     String
  order       ClientOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId      String?
  item        Item?       @relation(fields: [itemId], references: [id], onDelete: SetNull)
  itemName    String
  quantity    Decimal     @db.Decimal(18, 4)
  unitName    String?
  unitRate    Decimal     @db.Decimal(18, 2)
  taxRate     Decimal     @default(0.0000) @db.Decimal(8, 4)
  taxAmount     Decimal     @default(0.00) @db.Decimal(18, 2)
  totalAmount   Decimal     @db.Decimal(18, 2)
  notes         String?     @db.Text
  attachmentUrl String?     @db.Text

  @@index([orderId])
  @@map("client_order_items")
}

model ClientOrderAttachment {
  id          String         @id @default(uuid())
  orderId     String
  order       ClientOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fileType    AttachmentType @default(IMAGE)
  fileName    String
  fileUrl     String         @db.Text
  r2Key       String
  fileSize    Int?
  durationSec Int?
  createdAt   DateTime       @default(now())

  @@index([orderId])
  @@map("client_order_attachments")
}

// ----------------------------------------------------
// DESKTOP (ELECTRON) LICENSING & OFFLINE SYNC
// Additive tables only. They intentionally hold plain id strings instead of
// Prisma relations so that no existing model has to change.
// ----------------------------------------------------

model DesktopLicense {
  id               String    @id @default(uuid())
  licenseKey       String    @unique
  customerName     String
  ownerEmail       String
  ownerUserId      String?
  mobile           String?
  features         String    @db.Text
  maxDevices       Int       @default(1)
  status           String    @default("ACTIVE")
  validFrom        DateTime  @default(now())
  expiresAt        DateTime?
  offlineGraceDays Int       @default(15)
  allowSync        Boolean   @default(true)
  allowCloudBackup Boolean   @default(true)
  backupSecretEnc  String    @db.Text
  notes            String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([ownerEmail])
  @@map("desktop_licenses")
}

model DesktopActivation {
  id              String    @id @default(uuid())
  licenseId       String
  fingerprintHash String
  deviceName      String?
  platform        String?
  appVersion      String?
  devicePublicKey String    @db.Text
  status          String    @default("ACTIVE")
  seriesCode      String
  activatedAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  lastIp          String?
  linkedCompanyId String?
  linkedUserId    String?
  linkedAt        DateTime?
  lastSyncAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([licenseId, fingerprintHash])
  @@index([linkedCompanyId])
  @@map("desktop_activations")
}

model DesktopEvent {
  id           String   @id @default(uuid())
  licenseId    String?
  activationId String?
  event        String
  details      String?  @db.Text
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([licenseId, createdAt])
  @@map("desktop_events")
}

/// Every aggregate applied from a desktop push, so other devices linked to the
/// same company receive it (including deletes) on their next pull.
model DesktopSyncLog {
  seq          Int      @id @default(autoincrement())
  companyId    String
  model        String
  rootId       String
  activationId String
  op           String
  createdAt    DateTime @default(now())

  @@index([companyId, seq])
  @@map("desktop_sync_log")
}
